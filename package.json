{
  "name": "@sovereignbase/pwa",
  "version": "0.0.0",
  "description": "Pwaize your Web App.",
  "scripts": {
    "optimize": "npm run optimize:fonts && npm run optimize:images",
    "optimize:fonts": "node ./scripts/copyAndOptimizeFonts.js",
    "optimize:images": "node ./scripts/copyAndOptimizeImages.js",
    "build": "npm run build:appLoader && npm run build:mainScripts && npm run build:serviceWorker",
    "build:appLoader": "node ./src/appLoader/build.js",
    "build:mainScripts": "node ./src/mainScripts/build.js",
    "build:serviceWorker": "node ./src/serviceWorker/build.js",
    "dev": "npx wrangler dev",
    "start": "npm install && npm run optimize && npm run dev",
    "deploy": "npm run optimize && npx wrangler deploy"
  },
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "esbuild": "^0.27.0",
    "fontmin": "^2.0.3",
    "fs-extra": "^11.3.2",
    "html-minifier-terser": "^7.2.0",
    "sharp": "^0.34.5",
    "svgo": "^4.0.0",
    "wrangler": "^4.50.0"
  },
  "dependencies": {
    "@sovereignbase/utils": "^2.0.0",
    "lightningcss": "^1.33.0"
  }
}
