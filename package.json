{
  "name": "@sovereignbase/pwa",
  "version": "0.0.2",
  "description": "Build offline-first, search-engine-optimized progressive web applications.",
  "keywords": [
    "build-tool",
    "offline-first",
    "progressive-web-app",
    "pwa",
    "service-worker",
    "static-site-generation",
    "typescript"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "npm run build:package && npm run build:docs",
    "build:package": "tsdown",
    "build:docs": "typedoc",
    "build:example": "npm run build:package && node test/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit --project test/tsconfig.json",
    "test": "npm run build && npm run typecheck && npm run test:vitest && npm run test:runtimes && npm run test:e2e",
    "test:vitest": "vitest run --config test/vitest.config.ts --coverage",
    "test:runtimes": "npm run test:runtime:node && npm run test:runtime:bun",
    "test:runtime:node": "node test/runtimes/run.mjs",
    "test:runtime:bun": "bun test/runtimes/run.mjs",
    "test:e2e": "playwright test --config test/playwright.config.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@sovereignbase/bytecodec": "^1.7.0",
    "@sovereignbase/utils": "^2.0.0",
    "esbuild": "^0.28.2",
    "fs-extra": "^11.4.0",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.33.0",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/pwa.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/pwa/issues"
  },
  "homepage": "https://sovereignbase.dev/pwa"
}
